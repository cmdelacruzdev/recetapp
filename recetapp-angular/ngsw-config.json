{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/offline.html",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)",
          "/icons/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-read",
      "urls": ["/api/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": 10000,
        "maxSize": 50,
        "maxAge": 3600000
      }
    }
  ],
  "navigationUrls": [
    "^(?!.*\\.(?:html|css|js|json|svg|png|jpg|jpeg|gif|woff|woff2|ttf|ico|webmanifest)$)",
    "^(?!.*\\.(?:\\?|\\#).*)$"
  ],
  "fallback": "/offline.html"
}
